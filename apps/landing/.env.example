# Base URL advertised by GET /api/web-presence/bootstrap.
PRESENCE_API_BASE=http://localhost:3000/api/web-presence

# Raw Ed25519 public key, base64url encoded. Publishing is rejected until set.
PRESENCE_TRUSTED_PUBLIC_KEY=

# Optional only for local development. Production must inject durable stores by
# calling configureWebPresenceRuntime() from the application bootstrap.
PRESENCE_ALLOW_MEMORY=true
