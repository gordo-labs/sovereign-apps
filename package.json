{
  "name": "sovereign-apps",
  "version": "0.0.1",
  "private": true,
  "description": "Monorepo template for sovereign P2P apps — Electron, React Native and optional web-presence modules",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "pnpm -r --if-present --sort build",
    "dev": "pnpm -r --if-present --parallel dev",
    "clean": "pnpm -r --if-present --sort clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,cjs,json,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,cjs,json,yaml}\"",
    "tasks": "node scripts/list-workspace-tasks.mjs",
    "lint": "pnpm -r --if-present --sort lint",
    "test": "pnpm -r --if-present --sort test",
    "typecheck": "pnpm -r --if-present --sort typecheck"
  },
  "engines": {
    "node": ">=22.12 <23",
    "pnpm": ">=9.15.9 <10"
  },
  "devDependencies": {
    "typescript": "^5.6",
    "prettier": "^3.4",
    "@types/node": "^22",
    "eslint": "^9.17.0",
    "typescript-eslint": "^8.18.0"
  }
}
