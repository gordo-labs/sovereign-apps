{
  "name": "@sovereign-apps/electron-app",
  "version": "0.0.1",
  "description": "Sovereign App Template — Electron shell with Iroh QUIC P2P networking",
  "type": "module",
  "main": "dist/main.js",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js"
    },
    "./transport": {
      "types": "./dist/iroh-node.d.ts",
      "import": "./dist/iroh-node.js"
    },
    "./identity": {
      "types": "./dist/node-key.d.ts",
      "import": "./dist/node-key.js"
    },
    "./pairing": {
      "types": "./dist/secure-pairing.d.ts",
      "import": "./dist/secure-pairing.js"
    },
    "./lan-discovery": {
      "types": "./dist/lan-discovery.d.ts",
      "import": "./dist/lan-discovery.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/main.js",
    "electron": "electron dist/main.js",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "pnpm build && node --test test/*.test.ts",
    "prepack": "node ../../scripts/rewrite-published-manifest.mjs",
    "postpack": "node ../../scripts/restore-published-manifest.mjs"
  },
  "dependencies": {
    "bonjour-service": "^1.3.0",
    "@sovereign-apps/module-kernel": "workspace:*",
    "@momics/iroh-http-node": "^0.6.1",
    "@sovereign-apps/protocol": "workspace:*",
    "@types/qrcode": "^1.5.5",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^34",
    "electron-builder": "^25",
    "typescript": "^5.6"
  },
  "optionalDependencies": {
    "@momics/iroh-http-node-darwin-arm64": "0.6.1",
    "@momics/iroh-http-node-darwin-x64": "0.6.1",
    "@momics/iroh-http-node-linux-arm64-gnu": "0.6.1",
    "@momics/iroh-http-node-linux-x64-gnu": "0.6.1",
    "@momics/iroh-http-node-win32-x64-msvc": "0.6.1"
  }
}
