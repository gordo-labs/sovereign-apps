{
  "name": "@sovereign-apps/route-policy",
  "version": "0.0.1",
  "description": "Deterministic local-first route selection and reconnect policy",
  "repository": {
    "type": "git",
    "url": "https://github.com/gordo-labs/sovereign-apps.git",
    "directory": "packages/route-policy"
  },
  "bugs": {
    "url": "https://github.com/gordo-labs/sovereign-apps/issues"
  },
  "homepage": "https://github.com/gordo-labs/sovereign-apps#readme",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12 <23"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && node --test test/*.test.mjs",
    "clean": "rm -rf dist",
    "prepack": "node ../../scripts/rewrite-published-manifest.mjs",
    "postpack": "node ../../scripts/restore-published-manifest.mjs"
  },
  "dependencies": {
    "@sovereign-apps/module-kernel": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.6"
  }
}
